# ==============================================================================
# RPi Kiosk OS - Local Device Configuration Template
# Copy this file to /opt/kiosk/agent-device.env on the live device.
# This file is intentionally excluded from git via .gitignore.
# ==============================================================================

# Hardware Identification
DEVICE_HOSTNAME="kiosk"
DEVICE_MODEL="Raspberry Pi 4 Model B"
DEVICE_SERIAL=""

# Network & Connectivity
DEVICE_IP="192.168.X.X"
DEVICE_SSH_USER="pi"
DEVICE_SSH_PORT=22

# Home Assistant Integration
HA_HOST="umbrel.local"
HA_PORT=8123
HA_DASHBOARD_URL="http://umbrel.local:8123/dashboard-kiosk/0"
HA_WS_URL="ws://umbrel.local:8123/api/websocket"

# Display & Compositor
WAYLAND_DISPLAY="wayland-0"
COMPOSITOR="labwc"
CHROMIUM_CDP_PORT=9222

# Attached Peripherals
CONNECTED_CAMERA_DEV="/dev/video0"
KINECT_MODEL="Xbox 360 Kinect"
AUDIO_OUTPUT="HDMI / bcm2835"

# Security & Admin Access
WEBUI_PORT=8080
ADMIN_PIN_HASH=""
