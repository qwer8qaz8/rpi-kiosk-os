[Unit]
Description=Home Assistant MQTT Auto-Discovery & Kiosk Control Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/kiosk
ExecStart=/usr/bin/python3 /opt/kiosk/kiosk-mqtt.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
