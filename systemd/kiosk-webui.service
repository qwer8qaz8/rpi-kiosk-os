[Unit]
Description=Kiosk Local Web Management Interface (Port 8080)
After=network.target

[Service]
Type=simple
User=pi
Group=pi
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=WAYLAND_DISPLAY=wayland-0
WorkingDirectory=/opt/kiosk/webui
ExecStart=/usr/bin/python3 /opt/kiosk/webui/app.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
