<?xml version="1.0" encoding="UTF-8"?>
<labwc_config>
  <core>
    <decoration>server</decoration>
    <gap>8</gap>
  </core>

  <theme>
    <name>macOS</name>
    <cornerRadius>10</cornerRadius>
    <titlebar>
      <!-- Authentic macOS layout: Close, Iconify (Minimize), Maximize on the LEFT -->
      <layout>close,iconify,max:title</layout>
    </titlebar>
    <font name="sans-serif" size="11" />
  </theme>

  <windowRules>
    <!-- Fullscreen single-app Kiosk Mode: No borders, no titlebars, cover full display -->
    <windowRule identifier="chromium-kiosk" serverDecoration="no">
      <action name="Maximize" />
    </windowRule>

    <!-- Admin Desktop standalone windows: Framed with macOS traffic lights -->
    <windowRule identifier="chromium" serverDecoration="yes" />
    <windowRule identifier="foot" serverDecoration="yes" />
  </windowRules>

  <keyboard>
    <!-- Restart Kiosk Keybind: Ctrl+Alt+R -->
    <keybind key="C-A-r">
      <action name="Execute" command="/usr/bin/sudo /bin/systemctl restart kiosk-display" />
    </keybind>
    <!-- Emergency Lock Keybind: Ctrl+Alt+L -->
    <keybind key="C-A-l">
      <action name="Execute" command="/opt/kiosk/lock-kiosk.sh" />
    </keybind>
    <!-- Reboot Keybind: Ctrl+Alt+Delete -->
    <keybind key="C-A-Delete">
      <action name="Execute" command="/usr/bin/sudo /bin/systemctl reboot" />
    </keybind>
  </keyboard>

  <mouse>
    <default />
  </mouse>
</labwc_config>
