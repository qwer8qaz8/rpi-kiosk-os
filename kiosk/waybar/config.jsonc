[
  {
    "name": "kiosk-panel",
    "layer": "top",
    "position": "bottom",
    "height": 46,
    "modules-left": [
      "custom/launcher",
      "custom/dock-chrome",
      "custom/dock-settings",
      "custom/dock-camera",
      "custom/dock-terminal"
    ],
    "modules-right": [
      "custom/screencontrol",
      "custom/inputmode",
      "clock",
      "custom/exitkiosk"
    ],
    "custom/launcher": {
      "format": " ⚡ KioskOS ",
      "tooltip": "KioskOS System Menu",
      "on-click": "chromium --ozone-platform=wayland --app='http://127.0.0.1:8080/' --window-size=920,680"
    },
    "custom/dock-chrome": {
      "format": " 🌐 Chromium ",
      "tooltip": "Google Chrome Web Browser",
      "on-click": "chromium --ozone-platform=wayland 'chrome://newtab'"
    },
    "custom/dock-settings": {
      "format": " ⚙️ Control Center ",
      "tooltip": "Kiosk Settings",
      "on-click": "chromium --ozone-platform=wayland --app='http://127.0.0.1:8080/' --window-size=920,680"
    },
    "custom/dock-camera": {
      "format": " 📷 Camera &amp; Touch ",
      "tooltip": "Camera Optical Touchscreen &amp; Calibration",
      "on-click": "chromium --ozone-platform=wayland --app='http://127.0.0.1:8080/#display' --window-size=920,680"
    },
    "custom/dock-terminal": {
      "format": " 💻 Terminal ",
      "tooltip": "Linux Terminal Console",
      "on-click": "foot"
    },
    "custom/screencontrol": {
      "format": " 💡 Screen ",
      "tooltip": "Toggle Display Screen Power",
      "on-click": "/opt/kiosk/screen-control.sh toggle"
    },
    "custom/inputmode": {
      "format": " 🖥️ Display Mode ",
      "tooltip": "Touchscreen / Non-Touch Configuration",
      "on-click": "chromium --ozone-platform=wayland --app='http://127.0.0.1:8080/#display' --window-size=920,680"
    },
    "clock": {
      "format": "{:%a %b %d  %I:%M %p}",
      "tooltip-format": "{:%Y-%m-%d | %H:%M:%S}"
    },
    "custom/exitkiosk": {
      "format": " 🔒 Exit to Kiosk ",
      "tooltip": "Click to exit (with countdown) or hold to exit immediately",
      "on-click": "/opt/kiosk/prompt-exit.sh",
      "on-click-right": "/opt/kiosk/lock-kiosk.sh"
    }
  }
]
