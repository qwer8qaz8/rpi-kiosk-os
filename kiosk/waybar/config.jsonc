[
  {
    "name": "kiosk-dock",
    "layer": "top",
    "position": "bottom",
    "height": 62,
    "modules-center": [
      "custom/launcher",
      "custom/dock-chrome",
      "custom/dock-settings",
      "custom/dock-camera",
      "custom/dock-terminal",
      "custom/screencontrol",
      "clock",
      "custom/exitkiosk"
    ],
    "custom/launcher": {
      "format": " ⚡ KioskOS ",
      "tooltip": "KioskOS System Control",
      "on-click": "chromium --ozone-platform=wayland --user-data-dir=/tmp/chromium-kiosk-settings --app='http://127.0.0.1:8080/' --window-size=920,680"
    },
    "custom/dock-chrome": {
      "format": " 🌐 Chrome ",
      "tooltip": "Google Chrome Web Browser",
      "on-click": "chromium --ozone-platform=wayland --user-data-dir=/tmp/chromium-kiosk-browser --window-size=920,680 'chrome://newtab'"
    },
    "custom/dock-settings": {
      "format": " ⚙️ Settings ",
      "tooltip": "Control Center &amp; Configuration",
      "on-click": "chromium --ozone-platform=wayland --user-data-dir=/tmp/chromium-kiosk-settings --app='http://127.0.0.1:8080/' --window-size=920,680"
    },
    "custom/dock-camera": {
      "format": " 📷 Camera &amp; Touch ",
      "tooltip": "Camera Optical Touch Tracking &amp; Screen Calibration",
      "on-click": "chromium --ozone-platform=wayland --user-data-dir=/tmp/chromium-kiosk-settings --app='http://127.0.0.1:8080/#display' --window-size=920,680"
    },
    "custom/dock-terminal": {
      "format": " 💻 Terminal ",
      "tooltip": "Linux Console Terminal",
      "on-click": "foot"
    },
    "custom/screencontrol": {
      "format": " 💡 Screen ",
      "tooltip": "Toggle Display Screen Power",
      "on-click": "/opt/kiosk/screen-control.sh toggle"
    },
    "clock": {
      "format": " 🕒 {:%I:%M %p} ",
      "tooltip-format": "{:%a %b %d, %Y}"
    },
    "custom/exitkiosk": {
      "format": " 🔒 Exit to Kiosk ",
      "tooltip": "Click for countdown or hold 2s for instant exit",
      "on-click": "/opt/kiosk/prompt-exit.sh",
      "on-click-right": "/opt/kiosk/lock-kiosk.sh"
    }
  }
]
