#!/usr/bin/env bash
# ==============================================================================
# kioskos - The Official KioskOS CLI Management Tool
# ==============================================================================

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

CONFIG_FILE="/etc/kiosk/config.json"
[ ! -f "$CONFIG_FILE" ] && CONFIG_FILE="/opt/kiosk/config.json"

show_banner() {
cat << "EOF"
 ██╗  ██╗██╗ ██████╗ ███████╗██╗  ██╗ ██████╗ ███████╗
 ██║ ██╔╝██║██╔═══██╗██╔════╝██║ ██╔╝██╔═══██╗██╔════╝
 █████╔╝ ██║██║   ██║███████╗█████╔╝ ██║   ██║███████╗
 ██╔═██╗ ██║██║   ██║╚════██║██╔═██╗ ██║   ██║╚════██║
 ██║  ██╗██║╚██████╔╝███████║██║  ██╗╚██████╔╝███████║
 ╚═╝  ╚═╝╚═╝ ╚═════╝ ╚══════╝╚═╝  ╚═╝ ╚═════╝ ╚══════╝
                KioskOS Appliance Edition
EOF
}

cmd="${1:-}"

case "$cmd" in
  status)
    show_banner
    echo -e "${BOLD}System Status:${NC}"
    echo -e "  • Dashboard URL: ${CYAN}$(python3 -c "import json; print(json.load(open('$CONFIG_FILE')).get('dashboard_url', 'Not configured'))" 2>/dev/null || echo 'Unknown')${NC}"
    echo -e "  • Screen Power:  $(sudo /usr/local/bin/kiosk-screen status 2>/dev/null || echo 'ON')"
    echo -e "  • IP Address:    ${GREEN}$(hostname -I | awk '{print $1}')${NC}"
    echo -e "  • Kiosk Display: $(systemctl is-active kiosk-display 2>/dev/null || echo 'unknown')"
    echo -e "  • Kiosk WebUI:   $(systemctl is-active kiosk-webui 2>/dev/null || echo 'unknown') (http://$(hostname -I | awk '{print $1}'):8080)"
    echo -e "  • Mode:          $([ -f /tmp/kiosk-admin-workstation ] && echo "${YELLOW}Admin Desktop Mode${NC}" || echo "${GREEN}Fullscreen Locked Kiosk${NC}")"
    ;;

  url)
    new_url="$2"
    if [ -z "$new_url" ]; then
      echo -e "${RED}Error:${NC} Missing URL. Usage: kioskos url <dashboard_url>"
      exit 1
    fi
    echo -e "${CYAN}Setting Dashboard URL to:${NC} $new_url"
    python3 -c "
import json
for p in ['/etc/kiosk/config.json', '/opt/kiosk/config.json']:
    try:
        with open(p, 'r') as f: cfg = json.load(f)
        cfg['dashboard_url'] = '$new_url'
        with open(p, 'w') as f: json.dump(cfg, f, indent=2)
    except Exception: pass
" 2>/dev/null || sudo python3 -c "
import json
for p in ['/etc/kiosk/config.json', '/opt/kiosk/config.json']:
    try:
        with open(p, 'r') as f: cfg = json.load(f)
        cfg['dashboard_url'] = '$new_url'
        with open(p, 'w') as f: json.dump(cfg, f, indent=2)
    except Exception: pass
"
    echo -e "${GREEN}✓ Dashboard URL updated.${NC} Reloading display..."
    sudo systemctl restart kiosk-display
    ;;

  update)
    echo -e "${CYAN}[kioskos] Launching System Update...${NC}"
    if [ -n "$WAYLAND_DISPLAY" ] || [ -f /run/user/1000/wayland-0 ]; then
        /opt/kiosk/apply-update.sh
    else
        sudo /opt/kiosk/kiosk-config.sh --update
        sudo systemctl reboot
    fi
    ;;

  admin)
    sub="${2:-start}"
    case "$sub" in
      start|open)
        echo -e "${CYAN}[kioskos] Switching to Admin Desktop Mode...${NC}"
        /opt/kiosk/start-desktop.sh
        ;;
      enable|on)
        echo -e "${GREEN}[kioskos] Enabling Admin Mode...${NC}"
        python3 -c "
import json
for p in ['/etc/kiosk/config.json', '/opt/kiosk/config.json']:
    try:
        with open(p, 'r') as f: cfg = json.load(f)
        cfg['admin_enabled'] = True
        with open(p, 'w') as f: json.dump(cfg, f, indent=2)
    except Exception: pass
" 2>/dev/null || sudo python3 -c "
import json
for p in ['/etc/kiosk/config.json', '/opt/kiosk/config.json']:
    try:
        with open(p, 'r') as f: cfg = json.load(f)
        cfg['admin_enabled'] = True
        with open(p, 'w') as f: json.dump(cfg, f, indent=2)
    except Exception: pass
"
        echo -e "${GREEN}✓ Admin mode enabled.${NC}"
        ;;
      disable|off)
        echo -e "${YELLOW}[kioskos] Disabling Admin Mode...${NC}"
        python3 -c "
import json
for p in ['/etc/kiosk/config.json', '/opt/kiosk/config.json']:
    try:
        with open(p, 'r') as f: cfg = json.load(f)
        cfg['admin_enabled'] = False
        with open(p, 'w') as f: json.dump(cfg, f, indent=2)
    except Exception: pass
" 2>/dev/null || sudo python3 -c "
import json
for p in ['/etc/kiosk/config.json', '/opt/kiosk/config.json']:
    try:
        with open(p, 'r') as f: cfg = json.load(f)
        cfg['admin_enabled'] = False
        with open(p, 'w') as f: json.dump(cfg, f, indent=2)
    except Exception: pass
"
        echo -e "${YELLOW}✓ Admin mode disabled (on-device admin access blocked).${NC}"
        ;;
      status|*)
        echo -e "${BOLD}Admin Mode Status:${NC}"
        echo -e "  • Admin Enabled: $(python3 -c "import json; print(json.load(open('$CONFIG_FILE')).get('admin_enabled', True))" 2>/dev/null || echo 'True')"
        echo -e "  • Mode Active:   $([ -f /tmp/kiosk-admin-workstation ] && echo "${YELLOW}Admin Desktop Mode${NC}" || echo "${GREEN}Fullscreen Locked Kiosk${NC}")"
        ;;
    esac
    ;;

  speed)
    mode="${2:-status}"
    case "$mode" in
      turbo|kiosk-only)
        echo -e "${YELLOW}[kioskos] Enabling Turbo Appliance Mode (Kiosk-Only, admin listeners suppressed for maximum speed)...${NC}"
        python3 -c "
import json
for p in ['/etc/kiosk/config.json', '/opt/kiosk/config.json']:
    try:
        with open(p, 'r') as f: cfg = json.load(f)
        cfg['speed_mode'] = 'turbo'
        cfg['admin_enabled'] = False
        with open(p, 'w') as f: json.dump(cfg, f, indent=2)
    except Exception: pass
" 2>/dev/null || sudo python3 -c "
import json
for p in ['/etc/kiosk/config.json', '/opt/kiosk/config.json']:
    try:
        with open(p, 'r') as f: cfg = json.load(f)
        cfg['speed_mode'] = 'turbo'
        cfg['admin_enabled'] = False
        with open(p, 'w') as f: json.dump(cfg, f, indent=2)
    except Exception: pass
"
        echo -e "${GREEN}✓ Turbo Mode active.${NC} Restarting kiosk..."
        sudo systemctl restart kiosk-display
        ;;
      standard|normal)
        echo -e "${GREEN}[kioskos] Setting Standard Mode (Admin and listeners enabled)...${NC}"
        python3 -c "
import json
for p in ['/etc/kiosk/config.json', '/opt/kiosk/config.json']:
    try:
        with open(p, 'r') as f: cfg = json.load(f)
        cfg['speed_mode'] = 'standard'
        cfg['admin_enabled'] = True
        with open(p, 'w') as f: json.dump(cfg, f, indent=2)
    except Exception: pass
" 2>/dev/null || sudo python3 -c "
import json
for p in ['/etc/kiosk/config.json', '/opt/kiosk/config.json']:
    try:
        with open(p, 'r') as f: cfg = json.load(f)
        cfg['speed_mode'] = 'standard'
        cfg['admin_enabled'] = True
        with open(p, 'w') as f: json.dump(cfg, f, indent=2)
    except Exception: pass
"
        echo -e "${GREEN}✓ Standard Mode active.${NC} Restarting kiosk..."
        sudo systemctl restart kiosk-display
        ;;
      status|*)
        echo -e "${BOLD}Speed & Performance Mode:${NC}"
        echo -e "  • Speed Mode:   $(python3 -c "import json; print(json.load(open('$CONFIG_FILE')).get('speed_mode', 'standard'))" 2>/dev/null || echo 'standard')"
        echo -e "  • Admin Allowed: $(python3 -c "import json; print(json.load(open('$CONFIG_FILE')).get('admin_enabled', True))" 2>/dev/null || echo 'True')"
        ;;
    esac
    ;;

  webui)
    sub="${2:-status}"
    case "$sub" in
      start|on|enable)
        echo -e "${GREEN}[kioskos] Enabling and starting Remote WebUI service...${NC}"
        sudo systemctl enable kiosk-webui.service 2>/dev/null || true
        sudo systemctl restart kiosk-webui.service
        echo -e "${GREEN}✓ WebUI running at http://$(hostname -I | awk '{print $1}'):8080${NC}"
        ;;
      stop|off|disable)
        echo -e "${YELLOW}[kioskos] Stopping and disabling Remote WebUI service...${NC}"
        sudo systemctl stop kiosk-webui.service 2>/dev/null || true
        sudo systemctl disable kiosk-webui.service 2>/dev/null || true
        echo -e "${YELLOW}✓ WebUI disabled.${NC}"
        ;;
      status|*)
        echo -e "${BOLD}Remote WebUI Status:${NC}"
        echo -e "  • Service: $(systemctl is-active kiosk-webui 2>/dev/null || echo 'unknown')"
        echo -e "  • Enabled: $(systemctl is-enabled kiosk-webui 2>/dev/null || echo 'unknown')"
        echo -e "  • URL:     http://$(hostname -I | awk '{print $1}'):8080"
        ;;
    esac
    ;;

  lock)
    echo -e "${CYAN}[kioskos] Locking back to Fullscreen Kiosk Mode...${NC}"
    /opt/kiosk/lock-kiosk.sh
    ;;

  restart)
    echo -e "${CYAN}[kioskos] Restarting Kiosk Display...${NC}"
    sudo systemctl restart kiosk-display
    ;;

  reboot)
    echo -e "${YELLOW}[kioskos] Rebooting Raspberry Pi...${NC}"
    sudo systemctl reboot
    ;;

  maintenance)
    action="${2:-toggle}"
    echo -e "${CYAN}[kioskos] Maintenance Mode action: $action${NC}"
    curl -s -X POST -H "Content-Type: application/json" -d "{\"action\": \"$action\"}" http://127.0.0.1:8080/api/maintenance
    echo ""
    ;;

  backup)
    echo -e "${CYAN}[kioskos] Creating Clean System Backup (secrets stripped)...${NC}"
    /opt/kiosk/backup-kiosk.sh
    ;;

  chime)
    action="${2:-test}"
    case "$action" in
      on|enable)
        echo -e "${GREEN}[kioskos] Enabling startup audio chime...${NC}"
        python3 -c "
import json
for p in ['/etc/kiosk/config.json', '/opt/kiosk/config.json']:
    try:
        with open(p, 'r') as f: cfg = json.load(f)
        cfg['startup_chime'] = True
        with open(p, 'w') as f: json.dump(cfg, f, indent=2)
    except Exception: pass
" 2>/dev/null || sudo python3 -c "
import json
for p in ['/etc/kiosk/config.json', '/opt/kiosk/config.json']:
    try:
        with open(p, 'r') as f: cfg = json.load(f)
        cfg['startup_chime'] = True
        with open(p, 'w') as f: json.dump(cfg, f, indent=2)
    except Exception: pass
"
        /opt/kiosk/play-chime.sh
        ;;
      off|disable)
        echo -e "${YELLOW}[kioskos] Disabling startup audio chime...${NC}"
        python3 -c "
import json
for p in ['/etc/kiosk/config.json', '/opt/kiosk/config.json']:
    try:
        with open(p, 'r') as f: cfg = json.load(f)
        cfg['startup_chime'] = False
        with open(p, 'w') as f: json.dump(cfg, f, indent=2)
    except Exception: pass
" 2>/dev/null || sudo python3 -c "
import json
for p in ['/etc/kiosk/config.json', '/opt/kiosk/config.json']:
    try:
        with open(p, 'r') as f: cfg = json.load(f)
        cfg['startup_chime'] = False
        with open(p, 'w') as f: json.dump(cfg, f, indent=2)
    except Exception: pass
"
        ;;
      test|play|*)
        echo -e "${CYAN}[kioskos] Playing startup audio chime...${NC}"
        /opt/kiosk/play-chime.sh
        ;;
    esac
    ;;

  touch)
    subcmd="${2:-status}"
    case "$subcmd" in
      test)
        cam_id="${3:-0}"
        echo -e "${CYAN}[kioskos] Launching Camera Touch Test (Camera $cam_id)...${NC}"
        python3 /opt/kiosk/camera-touch/touch_test.py "$cam_id"
        ;;
      calibrate)
        cam_id="${3:-0}"
        echo -e "${CYAN}[kioskos] Launching Fullscreen Alignment & Marker Calibration (Camera $cam_id)...${NC}"
        python3 /opt/kiosk/camera-touch/touch_calibration.py "$cam_id"
        ;;
      start|on)
        echo -e "${GREEN}[kioskos] Starting Camera Touchscreen Service...${NC}"
        sudo systemctl enable kiosk-camera-touch.service 2>/dev/null || true
        sudo systemctl restart kiosk-camera-touch.service
        ;;
      stop|off)
        echo -e "${YELLOW}[kioskos] Stopping Camera Touchscreen Service...${NC}"
        sudo systemctl stop kiosk-camera-touch.service 2>/dev/null || true
        sudo systemctl disable kiosk-camera-touch.service 2>/dev/null || true
        ;;
      dynamic)
        dyn_action="${3:-status}"
        case "$dyn_action" in
          on|enable)
            echo -e "${GREEN}[kioskos] Enabling Dynamic Camera Mode (subtle corner mini-markers for moving cameras)...${NC}"
            python3 -c "
import json
for p in ['/etc/kiosk/config.json', '/opt/kiosk/config.json']:
    try:
        with open(p, 'r') as f: cfg = json.load(f)
        if 'camera_touch' not in cfg: cfg['camera_touch'] = {}
        cfg['camera_touch']['dynamic_tracking'] = True
        with open(p, 'w') as f: json.dump(cfg, f, indent=2)
    except Exception: pass
" 2>/dev/null || sudo python3 -c "
import json
for p in ['/etc/kiosk/config.json', '/opt/kiosk/config.json']:
    try:
        with open(p, 'r') as f: cfg = json.load(f)
        if 'camera_touch' not in cfg: cfg['camera_touch'] = {}
        cfg['camera_touch']['dynamic_tracking'] = True
        with open(p, 'w') as f: json.dump(cfg, f, indent=2)
    except Exception: pass
"
            sudo systemctl restart kiosk-camera-touch.service 2>/dev/null || true
            echo -e "${GREEN}✓ Dynamic Camera tracking enabled.${NC}"
            ;;
          off|disable)
            echo -e "${YELLOW}[kioskos] Disabling Dynamic Camera Mode...${NC}"
            python3 -c "
import json
for p in ['/etc/kiosk/config.json', '/opt/kiosk/config.json']:
    try:
        with open(p, 'r') as f: cfg = json.load(f)
        if 'camera_touch' not in cfg: cfg['camera_touch'] = {}
        cfg['camera_touch']['dynamic_tracking'] = False
        with open(p, 'w') as f: json.dump(cfg, f, indent=2)
    except Exception: pass
" 2>/dev/null || sudo python3 -c "
import json
for p in ['/etc/kiosk/config.json', '/opt/kiosk/config.json']:
    try:
        with open(p, 'r') as f: cfg = json.load(f)
        if 'camera_touch' not in cfg: cfg['camera_touch'] = {}
        cfg['camera_touch']['dynamic_tracking'] = False
        with open(p, 'w') as f: json.dump(cfg, f, indent=2)
    except Exception: pass
"
            sudo systemctl restart kiosk-camera-touch.service 2>/dev/null || true
            echo -e "${YELLOW}✓ Dynamic Camera tracking disabled.${NC}"
            ;;
          *)
            echo -e "Dynamic Camera Mode: $(python3 -c "import json; print(json.load(open('$CONFIG_FILE')).get('camera_touch', {}).get('dynamic_tracking', False))" 2>/dev/null || echo 'False')"
            ;;
        esac
        ;;
      mode)
        new_mode="${3:-status}"
        case "$new_mode" in
          single|dual|kinect)
            echo -e "${GREEN}[kioskos] Setting Camera Touch Mode to: $new_mode...${NC}"
            python3 -c "
import json
for p in ['/etc/kiosk/config.json', '/opt/kiosk/config.json']:
    try:
        with open(p, 'r') as f: cfg = json.load(f)
        if 'camera_touch' not in cfg: cfg['camera_touch'] = {}
        cfg['camera_touch']['mode'] = '$new_mode'
        with open(p, 'w') as f: json.dump(cfg, f, indent=2)
    except Exception: pass
" 2>/dev/null || sudo python3 -c "
import json
for p in ['/etc/kiosk/config.json', '/opt/kiosk/config.json']:
    try:
        with open(p, 'r') as f: cfg = json.load(f)
        if 'camera_touch' not in cfg: cfg['camera_touch'] = {}
        cfg['camera_touch']['mode'] = '$new_mode'
        with open(p, 'w') as f: json.dump(cfg, f, indent=2)
    except Exception: pass
"
            sudo systemctl restart kiosk-camera-touch.service 2>/dev/null || true
            echo -e "${GREEN}✓ Camera Touch Mode set to $new_mode.${NC}"
            ;;
          *)
            echo -e "Active Camera Mode: $(python3 -c "import json; print(json.load(open('$CONFIG_FILE')).get('camera_touch', {}).get('mode', 'single'))" 2>/dev/null || echo 'single')"
            ;;
        esac
        ;;
      status|*)
        echo -e "${BOLD}Camera Touchscreen Status:${NC}"
        echo -e "  • Service:      $(systemctl is-active kiosk-camera-touch.service 2>/dev/null || echo 'inactive')"
        echo -e "  • Mode:         $(python3 -c "import json; print(json.load(open('$CONFIG_FILE')).get('camera_touch', {}).get('mode', 'single'))" 2>/dev/null || echo 'single')"
        echo -e "  • Dynamic Mode: $(python3 -c "import json; print(json.load(open('$CONFIG_FILE')).get('camera_touch', {}).get('dynamic_tracking', False))" 2>/dev/null || echo 'False')"
        echo -e "  • Cameras:      $(ls /dev/video* 2>/dev/null | tr '\n' ' ' || echo 'None detected')"
        echo -e "  • Calibration:  $([ -f /etc/kiosk/camera-touch-calibration.json ] && echo "${GREEN}Calibrated${NC}" || echo "${YELLOW}Uncalibrated (Run 'kioskos touch calibrate')${NC}")"
        echo ""
        echo -e "Subcommands:"
        echo -e "  ${GREEN}kioskos touch test [cam]${NC}      Live camera test view & tracking"
        echo -e "  ${GREEN}kioskos touch calibrate [cam]${NC} Fullscreen corner marker alignment"
        echo -e "  ${GREEN}kioskos touch start|stop${NC}      Enable/disable background service"
        echo -e "  ${GREEN}kioskos touch dynamic on|off${NC}  Toggle subtle dynamic mini-markers"
        echo -e "  ${GREEN}kioskos touch mode [single|dual|kinect]${NC} Select optical sensor mode"
        ;;
    esac
    ;;

  *)
    show_banner
    echo -e "${BOLD}Usage:${NC} kioskos <command> [options]\n"
    echo -e "Commands:"
    echo -e "  ${GREEN}status${NC}        Show current KioskOS status, dashboard URL, and services"
    echo -e "  ${GREEN}url <URL>${NC}     Update Home Assistant / Kiosk dashboard URL and reload"
    echo -e "  ${GREEN}touch${NC}         Optical Camera Touchscreen (test, calibrate, dynamic, mode)"
    echo -e "  ${GREEN}speed${NC}         Speed & Performance Mode (standard vs turbo kiosk-only)"
    echo -e "  ${GREEN}admin${NC}         Switch into Admin Mode or enable/disable on-device admin"
    echo -e "  ${GREEN}webui${NC}         Remote Web Interface service (on, off, status)"
    echo -e "  ${GREEN}maintenance${NC}   Toggle or set Maintenance Mode (on/off/toggle)"
    echo -e "  ${GREEN}chime${NC}         Startup audio chime control (test, on, off)"
    echo -e "  ${GREEN}lock${NC}          Lock back into Fullscreen Single-App Kiosk Mode"
    echo -e "  ${GREEN}restart${NC}       Restart the kiosk display compositor"
    echo -e "  ${GREEN}reboot${NC}        Reboot the Raspberry Pi system"
    echo -e "  ${GREEN}update${NC}        Check for updates, display native update screen & reboot"
    echo -e "  ${GREEN}backup${NC}        Generate clean backup tarball without secrets"
    echo ""
    ;;
esac
