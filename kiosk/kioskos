#!/usr/bin/env bash
# ==============================================================================
# kioskos - Master CLI for Single-Purpose Home Assistant Kiosk Appliance
# 8Air • SuperG Technologies
# ==============================================================================

set -e

CONFIG_FILE="/etc/kiosk/config.json"
[ ! -f "$CONFIG_FILE" ] && CONFIG_FILE="/opt/kiosk/config.json"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

BOLD="\033[1m"
GREEN="\033[32m"
CYAN="\033[36m"
YELLOW="\033[33m"
RED="\033[31m"
MAGENTA="\033[35m"
NC="\033[0m"

show_banner() {
cat << "EOF"
  ██╗  ██╗ █████╗     ██╗  ██╗██╗ ██████╗ ███████╗██╗  ██╗
  ██║  ██║██╔══██╗    ██║ ██╔╝██║██╔═══██╗██╔════╝██║ ██╔╝
  ███████║███████║    █████╔╝ ██║██║   ██║███████╗█████╔╝ 
  ██╔══██║██╔══██║    ██╔═██╗ ██║██║   ██║╚════██║██╔═██╗ 
  ██║  ██║██║  ██║    ██║  ██╗██║╚██████╔╝███████║██║  ██╗
  ╚═╝  ╚═╝╚═╝  ╚═╝    ╚═╝  ╚═╝╚═╝ ╚═════╝ ╚══════╝╚═╝  ╚═╝
             Home Assistant Kiosk Appliance
             8Air  •  SuperG Technologies
EOF
}

cmd="${1:-}"

case "$cmd" in
  setup)
    show_banner
    echo -e "${BOLD}Home Assistant Kiosk Setup Wizard${NC}\n"
    
    # 1. Run Hardware Detection Check
    echo -e "${CYAN}[1/4] Detecting hardware and screen details...${NC}"
    if [ -x "$SCRIPT_DIR/hardware-profiles.py" ]; then
      python3 "$SCRIPT_DIR/hardware-profiles.py" apply
    fi
    echo ""

    # 2. Home Assistant URL
    echo -e "${CYAN}[2/4] Home Assistant Connection${NC}"
    read -p "Enter Home Assistant Base URL [http://homeassistant.local:8123]: " ha_url
    ha_url="${ha_url:-http://homeassistant.local:8123}"
    
    read -p "Enter Dashboard Path [/dashboard-kiosk/0 or /lovelace/0]: " ha_dash
    ha_dash="${ha_dash:-/dashboard-kiosk/0}"
    
    ha_url="${ha_url%/}"
    ha_dash="${ha_dash#/}"
    full_url="${ha_url}/${ha_dash}"
    if [[ ! "$full_url" =~ "kiosk" ]]; then
      if [[ "$full_url" =~ \? ]]; then full_url="${full_url}&kiosk"; else full_url="${full_url}?kiosk"; fi
    fi
    
    # 3. Auto-Login Credentials
    echo -e "\n${CYAN}[3/4] Home Assistant Auto-Login Credentials${NC}"
    echo "The kiosk will automatically log into this account without displaying password prompts."
    read -p "Home Assistant Username [kiosk]: " ha_user
    ha_user="${ha_user:-kiosk}"
    read -s -p "Home Assistant Password: " ha_pass
    echo ""
    
    # 4. Display Orientation
    echo -e "\n${CYAN}[4/4] Screen Orientation${NC}"
    echo "  1) Standard Landscape (normal)"
    echo "  2) Portrait (90° clockwise)"
    echo "  3) Inverted Landscape (180°)"
    echo "  4) Inverted Portrait (270° clockwise)"
    read -p "Select [1-4, default 1]: " rot_choice
    case "$rot_choice" in
      2) rot="90" ;;
      3) rot="180" ;;
      4) rot="270" ;;
      *) rot="normal" ;;
    esac

    python3 -c "
import json
for p in ['/etc/kiosk/config.json', '/opt/kiosk/config.json']:
    try:
        with open(p, 'r') as f: cfg = json.load(f)
        cfg['dashboard_url'] = '$full_url'
        cfg['ha_username'] = '$ha_user'
        if '$ha_pass': cfg['ha_password'] = '$ha_pass'
        cfg['display_rotation'] = '$rot'
        cfg.pop('webui_pin', None)
        with open(p, 'w') as f: json.dump(cfg, f, indent=2)
    except Exception: pass
" 2>/dev/null || sudo python3 -c "
import json
for p in ['/etc/kiosk/config.json', '/opt/kiosk/config.json']:
    try:
        with open(p, 'r') as f: cfg = json.load(f)
        cfg['dashboard_url'] = '$full_url'
        cfg['ha_username'] = '$ha_user'
        if '$ha_pass': cfg['ha_password'] = '$ha_pass'
        cfg['display_rotation'] = '$rot'
        cfg.pop('webui_pin', None)
        with open(p, 'w') as f: json.dump(cfg, f, indent=2)
    except Exception: pass
"
    echo -e "\n${GREEN}✓ Appliance setup successfully completed!${NC}"
    echo -e "Dashboard URL: ${CYAN}$full_url${NC}"
    echo -e "Restarting display..."
    sudo systemctl restart kiosk-display
    ;;

  status)
    show_banner
    echo -e "${BOLD}Appliance Status & Telemetry:${NC}"
    echo -e "  • Dashboard URL:  ${CYAN}$(python3 -c "import json; print(json.load(open('$CONFIG_FILE')).get('dashboard_url', 'Not configured'))" 2>/dev/null || echo 'Unknown')${NC}"
    echo -e "  • Screen Power:   $(sudo /usr/local/bin/kiosk-screen status 2>/dev/null || echo 'ON')"
    echo -e "  • Brightness:     $(python3 -c "import json; print(json.load(open('$CONFIG_FILE')).get('brightness', 100))" 2>/dev/null || echo '100')%"
    echo -e "  • Rotation:       $(python3 -c "import json; print(json.load(open('$CONFIG_FILE')).get('display_rotation', 'normal'))" 2>/dev/null || echo 'normal')"
    echo -e "  • IP Address:     ${GREEN}$(hostname -I 2>/dev/null | awk '{print $1}' || echo '127.0.0.1')${NC}"
    echo -e "  • Display Engine: $(systemctl is-active kiosk-display 2>/dev/null || echo 'active')"
    echo -e "  • Auto-Login:     $(python3 -c "import json; u = json.load(open('$CONFIG_FILE')).get('ha_username', ''); print('Configured (' + u + ')' if u else 'None')" 2>/dev/null || echo 'None')"
    
    # Telemetry and hardware info
    if [ -f /etc/kiosk/hardware-info.json ]; then
      python3 -c "
import json
try:
    with open('/etc/kiosk/hardware-info.json') as f:
        hw = json.load(f)
    print(f'  • Hardware:       \033[35m{hw.get(\"device_model\", \"Unknown\")}\033[0m ({hw.get(\"ram\", {}).get(\"total_gb\", \"\")} GB RAM)')
    print(f'  • Active Profile: \033[36m{hw.get(\"profile_id\", \"Unknown\")}\033[0m ({hw.get(\"profile_name\", \"\")})')
    print(f'  • Screen Res:     \033[32m{hw.get(\"display\", {}).get(\"resolution\", \"Unknown\")}\033[0m on {hw.get(\"display\", {}).get(\"primary\", {}).get(\"connector\", \"HDMI\")}')
    if hw.get('temperature_c'):
        print(f'  • Temperature:    {hw.get(\"temperature_c\")} °C')
except Exception: pass
" 2>/dev/null
    fi
    echo -e "  • Mode:           ${GREEN}Single-Purpose Lockdown Fullscreen${NC}"
    ;;

  hw|device|hardware)
    if [ -x "$SCRIPT_DIR/hardware-profiles.py" ]; then
      python3 "$SCRIPT_DIR/hardware-profiles.py" "${2:-report}"
    elif [ -x /opt/kiosk/hardware-profiles.py ]; then
      python3 /opt/kiosk/hardware-profiles.py "${2:-report}"
    else
      echo -e "${RED}Error: hardware-profiles.py not found.${NC}"
    fi
    ;;

  profile|profiles)
    sub="${2:-list}"
    case "$sub" in
      list)
        python3 "$SCRIPT_DIR/hardware-profiles.py" list
        ;;
      apply|set)
        pname="$3"
        if [ -z "$pname" ]; then
          echo "Usage: kioskos profile apply <profile_id>"
          python3 "$SCRIPT_DIR/hardware-profiles.py" list
          exit 1
        fi
        sudo python3 "$SCRIPT_DIR/hardware-profiles.py" apply "$pname"
        echo -e "${GREEN}✓ Hardware profile applied. Reloading display...${NC}"
        sudo systemctl restart kiosk-display
        ;;
      *)
        python3 "$SCRIPT_DIR/hardware-profiles.py" list
        ;;
    esac
    ;;

  settings|config)
    sub="${2:-list}"
    case "$sub" in
      set)
        key="$3"
        val="$4"
        if [ -z "$key" ] || [ -z "$val" ]; then
          echo -e "${RED}Usage:${NC} kioskos set <setting> <value>"
          echo -e "Example: kioskos set brightness 80"
          exit 1
        fi
        python3 -c "
import json, sys, subprocess

key = '$key'.strip().lower()
val = '$val'.strip()

cfg_file = '$CONFIG_FILE'
with open(cfg_file, 'r') as f:
    cfg = json.load(f)

if val.lower() in ['true', 'on', 'yes', '1']:
    parsed_val = True
elif val.lower() in ['false', 'off', 'no', '0']:
    parsed_val = False
else:
    try:
        parsed_val = int(val)
    except ValueError:
        parsed_val = val

reload_display = False
restart_touch = False

if key in ['url', 'dashboard_url']:
    cfg['dashboard_url'] = str(parsed_val)
    reload_display = True
elif key in ['brightness', 'screen_brightness']:
    b = max(10, min(100, int(parsed_val)))
    cfg['brightness'] = b
    subprocess.run(['sudo', '/usr/local/bin/kiosk-screen', 'brightness', str(b)], capture_output=True)
elif key in ['power', 'screen', 'screen_on']:
    p = bool(parsed_val)
    cfg['screen_on'] = p
    subprocess.run(['sudo', '/usr/local/bin/kiosk-screen', 'on' if p else 'off'], capture_output=True)
elif key in ['rotation', 'display_rotation']:
    if str(parsed_val) in ['normal', '90', '180', '270']:
        cfg['display_rotation'] = str(parsed_val)
        subprocess.run(['sudo', '/usr/local/bin/kiosk-screen', 'rotate', str(parsed_val)], capture_output=True)
        reload_display = True
elif key in ['chime', 'startup_chime']:
    cfg['startup_chime'] = bool(parsed_val)
elif key in ['ha_user', 'ha_username']:
    cfg['ha_username'] = str(parsed_val)
    reload_display = True
elif key in ['ha_pass', 'ha_password']:
    cfg['ha_password'] = str(parsed_val)
    reload_display = True
elif key in ['mqtt_broker']:
    if 'mqtt' not in cfg: cfg['mqtt'] = {}
    cfg['mqtt']['broker'] = str(parsed_val)
    subprocess.run(['sudo', 'systemctl', 'restart', 'kiosk-mqtt.service'], capture_output=True)
else:
    cfg[key] = parsed_val

with open(cfg_file, 'w') as f:
    json.dump(cfg, f, indent=2)

print(f'\033[32m✓ Setting \'{key}\' updated to: {parsed_val}\033[0m')

if reload_display:
    print('• Reloading display engine...')
    subprocess.run(['sudo', 'systemctl', 'restart', 'kiosk-display'])
"
        ;;

      get)
        key="$3"
        if [ -z "$key" ]; then
          echo -e "${RED}Usage:${NC} kioskos get <setting>"
          exit 1
        fi
        python3 -c "
import json
with open('$CONFIG_FILE') as f:
    cfg = json.load(f)
key = '$key'.strip().lower()
mapped = {'url': 'dashboard_url', 'brightness': 'brightness', 'power': 'screen_on', 'rotation': 'display_rotation', 'chime': 'startup_chime', 'ha_user': 'ha_username', 'ha_pass': 'ha_password'}
k = mapped.get(key, key)
if k == 'mqtt_broker':
    print(cfg.get('mqtt', {}).get('broker', ''))
else:
    print(cfg.get(k, 'Not set'))
"
        ;;

      list|*)
        python3 -c "
import json
with open('$CONFIG_FILE') as f:
    cfg = json.load(f)

print('=' * 80)
print(' Home Assistant Kiosk Appliance Settings (/etc/kiosk/config.json)')
print('=' * 80)
print('')
print('\033[1m[Display & Dashboard]\033[0m')
print(f'  • url               {cfg.get(\"dashboard_url\", \"Not set\")}')
print('                      (Home Assistant dashboard target URL)')
print(f'  • screen_on         {cfg.get(\"screen_on\", True)}')
print('                      (Hardware screen power: true / false)')
print(f'  • brightness        {cfg.get(\"brightness\", 100)}')
print('                      (Screen backlight percentage: 10 - 100)')
print(f'  • rotation          {cfg.get(\"display_rotation\", \"normal\")}')
print('                      (Display orientation: normal, 90, 180, 270)')
print('')
print('\033[1m[Audio & Notifications]\033[0m')
print(f'  • chime             {cfg.get(\"startup_chime\", True)}')
print('                      (Startup & notification sound enabled: true / false)')
print('')
print('\033[1m[Home Assistant Auto-Login]\033[0m')
print(f'  • ha_user           {cfg.get(\"ha_username\", \"kiosk\")}')
print('                      (Auto-login username for dashboard session)')
has_pass = 'Configured' if cfg.get(\"ha_password\") else 'None'
print(f'  • ha_pass           [{has_pass}]')
print('                      (Auto-login password for dashboard session)')
print('')
print('\033[1m[MQTT Integration]\033[0m')
mqtt = cfg.get(\"mqtt\", {})
print(f'  • mqtt_broker       {mqtt.get(\"broker\", \"\")}')
print('                      (Home Assistant MQTT telemetry broker)')
print('')
print('-' * 80)
print('To change any setting from CLI:')
print('  \033[32mkioskos set <setting> <value>\033[0m')
print('  e.g.: kioskos set brightness 80')
print('        kioskos set url http://homeassistant.local:8123/lovelace/0')
print('        kioskos set rotation 90')
print('=' * 80)
"
        ;;
    esac
    ;;

  set)
    shift
    /opt/kiosk/kioskos settings set "$@"
    ;;

  get)
    shift
    /opt/kiosk/kioskos settings get "$@"
    ;;

  url)
    new_url="$2"
    if [ -z "$new_url" ]; then
      echo -e "${RED}Error:${NC} Missing URL. Usage: kioskos url <dashboard_url>"
      exit 1
    fi
    /opt/kiosk/kioskos set url "$new_url"
    ;;

  autologin)
    user="$2"
    pass="$3"
    if [ -z "$user" ]; then
      read -r -p "Home Assistant Username: " user
      read -r -s -p "Home Assistant Password: " pass
      echo ""
    fi
    /opt/kiosk/kioskos set ha_user "$user"
    if [ -n "$pass" ]; then
      /opt/kiosk/kioskos set ha_pass "$pass"
    fi
    echo -e "${GREEN}✓ Auto-login credentials saved and kiosk reloaded!${NC}"
    ;;

  screen)
    action="${2:-status}"
    case "$action" in
      sleep)
        /opt/kiosk/screen-control.sh sleep
        ;;
      on|off)
        /opt/kiosk/kioskos set screen "$action"
        ;;
      status|*)
        sudo /usr/local/bin/kiosk-screen status
        ;;
    esac
    ;;

  brightness)
    val="$2"
    if [ -z "$val" ]; then
      echo -e "Current brightness: $(/opt/kiosk/kioskos get brightness)%"
    else
      /opt/kiosk/kioskos set brightness "$val"
    fi
    ;;

  rotate)
    val="$2"
    if [ -z "$val" ]; then
      echo -e "Current rotation: $(/opt/kiosk/kioskos get rotation)"
    else
      /opt/kiosk/kioskos set rotation "$val"
    fi
    ;;

  chime)
    sound="${2:-bing}"
    case "$sound" in
      bing|boot|unlock|lock|alert|touch)
        echo -e "${CYAN}[kioskos] Playing $sound chime...${NC}"
        /opt/kiosk/play-chime.sh "$sound"
        ;;
      on|enable)
        /opt/kiosk/kioskos set chime true
        /opt/kiosk/play-chime.sh bing
        ;;
      off|disable)
        /opt/kiosk/kioskos set chime false
        ;;
      *)
        echo -e "${CYAN}[kioskos] Playing chime: $sound...${NC}"
        /opt/kiosk/play-chime.sh "$sound"
        ;;
    esac
    ;;

  mcp)
    sub="${2:-run}"
    case "$sub" in
      run|start)
        python3 /opt/kiosk/kiosk-mcp.py
        ;;
      test)
        echo -e "${CYAN}[kioskos] Testing MCP Server Tools...${NC}"
        echo '{"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {}}' | python3 /opt/kiosk/kiosk-mcp.py
        echo '{"jsonrpc": "2.0", "id": 2, "method": "tools/list", "params": {}}' | python3 /opt/kiosk/kiosk-mcp.py
        ;;
      status|*)
        echo -e "${BOLD}KioskOS Model Context Protocol (MCP) Server:${NC}"
        echo -e "  • Path:        /opt/kiosk/kiosk-mcp.py"
        echo -e "  • Protocol:    MCP JSON-RPC 2.0 (stdio)"
        ;;
    esac
    ;;

  restart)
    echo -e "${CYAN}[kioskos] Restarting Home Assistant Kiosk display...${NC}"
    sudo systemctl restart kiosk-display
    ;;

  reboot)
    echo -e "${YELLOW}[kioskos] Manual reboot requested. Rebooting Raspberry Pi appliance...${NC}"
    sudo systemctl reboot
    ;;

  update)
    action="${2:-apply}"
    case "$action" in
      check)
        echo -e "${CYAN}[kioskos] Checking GitHub for updates...${NC}"
        sudo /opt/kiosk/kiosk-config.sh check-update
        ;;
      apply|*)
        echo -e "${CYAN}[kioskos] Updating KioskOS from GitHub...${NC}"
        sudo /opt/kiosk/kiosk-config.sh --update
        ;;
    esac
    ;;

  backup)
    sub="${2:-create}"
    shift 2 || true
    if [ -x "$SCRIPT_DIR/backup-kiosk.sh" ]; then
      "$SCRIPT_DIR/backup-kiosk.sh" "$sub" "$@"
    elif [ -x /opt/kiosk/backup-kiosk.sh ]; then
      /opt/kiosk/backup-kiosk.sh "$sub" "$@"
    else
      echo -e "${RED}Error: backup-kiosk.sh not found.${NC}"
    fi
    ;;

  *)
    show_banner
    echo -e "${BOLD}Usage:${NC} kioskos <command> [options]\n"
    echo -e "Commands:"
    echo -e "  ${GREEN}status${NC}                   Show appliance status, telemetry & active hardware profile"
    echo -e "  ${GREEN}hw${NC} / ${GREEN}device${NC}             Inspect physical hardware, screen resolution & optimal profile"
    echo -e "  ${GREEN}profile [list|apply <id>]${NC}  Manage hardware optimization profiles"
    echo -e "  ${GREEN}setup${NC}                    Interactive single-purpose Home Assistant setup wizard"
    echo -e "  ${GREEN}settings${NC} / ${GREEN}config${NC}         List all appliance configuration settings"
    echo -e "  ${GREEN}set <key> <val>${NC}          Modify setting (url, brightness, rotation, ha_user, etc.)"
    echo -e "  ${GREEN}get <key>${NC}                Get current value of a setting"
    echo -e "  ${GREEN}url <URL>${NC}                Set Home Assistant dashboard target URL"
    echo -e "  ${GREEN}autologin [user] [pass]${NC}  Configure automatic Home Assistant credentials"
    echo -e "  ${GREEN}screen [on|off]${NC}          Control display power immediately"
    echo -e "  ${GREEN}brightness <10-100>${NC}      Adjust backlight brightness level"
    echo -e "  ${GREEN}rotate <normal|90|180|270>${NC} Set screen rotation"
    echo -e "  ${GREEN}chime [sound]${NC}            Play sound effect (bing, boot, alert, etc.)"
    echo -e "  ${GREEN}backup [create|list|restore]${NC} Create or restore sanitized/full backups"
    echo -e "  ${GREEN}update [check|apply]${NC}     Check or install GitHub updates (reloads display without reboot)"
    echo -e "  ${GREEN}restart${NC}                  Restart kiosk display compositor"
    echo -e "  ${GREEN}reboot${NC}                   Manual system reboot"
    echo ""
    ;;
esac
