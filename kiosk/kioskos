#!/usr/bin/env bash
# ==============================================================================
# kioskos - Master Command-Line Interface for Home Assistant Kiosk Appliance
# 8Air • SuperG Technologies
# ==============================================================================

set -e

CONFIG_FILE="/etc/kiosk/config.json"
[ ! -f "$CONFIG_FILE" ] && CONFIG_FILE="/opt/kiosk/config.json"

BOLD="\033[1m"
GREEN="\033[32m"
CYAN="\033[36m"
YELLOW="\033[33m"
RED="\033[31m"
NC="\033[0m"

show_banner() {
cat << "EOF"
  ██╗  ██╗ █████╗     ██╗  ██╗██╗ ██████╗ ███████╗██╗  ██╗
  ██║  ██║██╔══██╗    ██║ ██╔╝██║██╔═══██╗██╔════╝██║ ██╔╝
  ███████║███████║    █████╔╝ ██║██║   ██║███████╗█████╔╝ 
  ██╔══██║██╔══██║    ██╔═██╗ ██║██║   ██║╚════██║██╔═██╗ 
  ██║  ██║██║  ██║    ██║  ██╗██║╚██████╔╝███████║██║  ██╗
  ╚═╝  ╚═╝╚═╝  ╚═╝    ╚═╝  ╚═╝╚═╝ ╚═════╝ ╚══════╝╚═╝  ╚═╝
             Home Assistant Kiosk Appliance
             8Air  •  SuperG Technologies
EOF
}

cmd="${1:-}"

case "$cmd" in
  setup)
    show_banner
    echo -e "${BOLD}Home Assistant Kiosk Setup Wizard${NC}\n"
    read -p "Enter Home Assistant Base URL [http://homeassistant.local:8123]: " ha_url
    ha_url="${ha_url:-http://homeassistant.local:8123}"
    
    read -p "Enter Dashboard Path [/dashboard-kiosk/0 or /lovelace/0]: " ha_dash
    ha_dash="${ha_dash:-/dashboard-kiosk/0}"
    
    ha_url="${ha_url%/}"
    ha_dash="${ha_dash#/}"
    full_url="${ha_url}/${ha_dash}"
    if [[ ! "$full_url" =~ "kiosk" ]]; then
      if [[ "$full_url" =~ \? ]]; then full_url="${full_url}&kiosk"; else full_url="${full_url}?kiosk"; fi
    fi
    
    read -p "Home Assistant Kiosk Username (optional for auto-login): " ha_user
    read -s -p "Home Assistant Kiosk Password (optional for auto-login): " ha_pass
    echo ""
    
    python3 -c "
import json
for p in ['/etc/kiosk/config.json', '/opt/kiosk/config.json']:
    try:
        with open(p, 'r') as f: cfg = json.load(f)
        cfg['dashboard_url'] = '$full_url'
        if '$ha_user': cfg['ha_username'] = '$ha_user'
        if '$ha_pass': cfg['ha_password'] = '$ha_pass'
        with open(p, 'w') as f: json.dump(cfg, f, indent=2)
    except Exception: pass
" 2>/dev/null || sudo python3 -c "
import json
for p in ['/etc/kiosk/config.json', '/opt/kiosk/config.json']:
    try:
        with open(p, 'r') as f: cfg = json.load(f)
        cfg['dashboard_url'] = '$full_url'
        if '$ha_user': cfg['ha_username'] = '$ha_user'
        if '$ha_pass': cfg['ha_password'] = '$ha_pass'
        with open(p, 'w') as f: json.dump(cfg, f, indent=2)
    except Exception: pass
"
    echo -e "\n${GREEN}✓ Configuration saved successfully!${NC}"
    echo -e "Dashboard URL: ${CYAN}$full_url${NC}"
    echo -e "Restarting display..."
    sudo systemctl restart kiosk-display
    ;;

  status)
    show_banner
    echo -e "${BOLD}Appliance Status & Telemetry:${NC}"
    echo -e "  • Dashboard URL:  ${CYAN}$(python3 -c "import json; print(json.load(open('$CONFIG_FILE')).get('dashboard_url', 'Not configured'))" 2>/dev/null || echo 'Unknown')${NC}"
    echo -e "  • Screen Power:   $(sudo /usr/local/bin/kiosk-screen status 2>/dev/null || echo 'ON')"
    echo -e "  • Brightness:     $(python3 -c "import json; print(json.load(open('$CONFIG_FILE')).get('screen_brightness', 100))" 2>/dev/null || echo '100')%"
    echo -e "  • Rotation:       $(python3 -c "import json; print(json.load(open('$CONFIG_FILE')).get('display_rotation', 'normal'))" 2>/dev/null || echo 'normal')"
    echo -e "  • IP Address:     ${GREEN}$(hostname -I | awk '{print $1}')${NC}"
    echo -e "  • Display Engine: $(systemctl is-active kiosk-display 2>/dev/null || echo 'unknown')"
    echo -e "  • Chime Service:  $(systemctl is-active kiosk-chime 2>/dev/null || echo 'unknown') (http://$(hostname -I | awk '{print $1}'):8124/chime?sound=bing)"
    echo -e "  • Touch Daemon:   $(systemctl is-active kiosk-camera-touch.service 2>/dev/null || echo 'inactive')"
    echo -e "  • Mode:           ${GREEN}Single-Purpose Lockdown Fullscreen${NC}"
    ;;

  settings|config)
    sub="${2:-list}"
    case "$sub" in
      set)
        key="$3"
        val="$4"
        if [ -z "$key" ] || [ -z "$val" ]; then
          echo -e "${RED}Usage:${NC} kioskos set <setting> <value>"
          echo -e "Example: kioskos set brightness 80"
          exit 1
        fi
        python3 -c "
import json, sys, subprocess

key = '$key'.strip().lower()
val = '$val'.strip()

cfg_file = '$CONFIG_FILE'
with open(cfg_file, 'r') as f:
    cfg = json.load(f)

# Handle boolean and numeric types
if val.lower() in ['true', 'on', 'yes', '1']:
    parsed_val = True
elif val.lower() in ['false', 'off', 'no', '0']:
    parsed_val = False
else:
    try:
        parsed_val = int(val)
    except ValueError:
        parsed_val = val

# Mapping
reload_display = False
restart_touch = False

if key in ['url', 'dashboard_url']:
    cfg['dashboard_url'] = str(parsed_val)
    reload_display = True
elif key in ['brightness', 'screen_brightness']:
    b = max(10, min(100, int(parsed_val)))
    cfg['screen_brightness'] = b
    cfg['brightness'] = b
    subprocess.run(['sudo', '/usr/local/bin/kiosk-screen', 'brightness', str(b)], capture_output=True)
elif key in ['power', 'screen', 'screen_on']:
    p = bool(parsed_val)
    cfg['screen_on'] = p
    subprocess.run(['sudo', '/usr/local/bin/kiosk-screen', 'on' if p else 'off'], capture_output=True)
elif key in ['rotation', 'display_rotation']:
    if str(parsed_val) in ['normal', '90', '180', '270']:
        cfg['display_rotation'] = str(parsed_val)
        subprocess.run(['sudo', '/usr/local/bin/kiosk-screen', 'rotate', str(parsed_val)], capture_output=True)
        reload_display = True
elif key in ['chime', 'startup_chime']:
    cfg['startup_chime'] = bool(parsed_val)
elif key in ['touch', 'touch_enabled']:
    if 'camera_touch' not in cfg: cfg['camera_touch'] = {}
    cfg['camera_touch']['enabled'] = bool(parsed_val)
    action = 'start' if parsed_val else 'stop'
    subprocess.run(['sudo', 'systemctl', action, 'kiosk-camera-touch.service'], capture_output=True)
elif key in ['touch_mode', 'camera_mode']:
    if str(parsed_val) in ['single', 'dual', 'kinect']:
        if 'camera_touch' not in cfg: cfg['camera_touch'] = {}
        cfg['camera_touch']['mode'] = str(parsed_val)
        restart_touch = True
elif key in ['touch_dynamic', 'dynamic_tracking']:
    if 'camera_touch' not in cfg: cfg['camera_touch'] = {}
    cfg['camera_touch']['dynamic_tracking'] = bool(parsed_val)
    restart_touch = True
elif key in ['ha_user', 'ha_username']:
    cfg['ha_username'] = str(parsed_val)
    reload_display = True
elif key in ['ha_pass', 'ha_password']:
    cfg['ha_password'] = str(parsed_val)
    reload_display = True
elif key in ['night_mode', 'night_mode_enabled']:
    cfg['night_mode_enabled'] = bool(parsed_val)
elif key in ['mqtt_broker']:
    if 'mqtt' not in cfg: cfg['mqtt'] = {}
    cfg['mqtt']['broker'] = str(parsed_val)
    subprocess.run(['sudo', 'systemctl', 'restart', 'kiosk-mqtt.service'], capture_output=True)
else:
    cfg[key] = parsed_val

with open(cfg_file, 'w') as f:
    json.dump(cfg, f, indent=2)

print(f'\033[32m✓ Setting \'{key}\' updated to: {parsed_val}\033[0m')

if reload_display:
    print('• Reloading display engine...')
    subprocess.run(['sudo', 'systemctl', 'restart', 'kiosk-display'])
if restart_touch:
    print('• Restarting touch digitizer...')
    subprocess.run(['sudo', 'systemctl', 'restart', 'kiosk-camera-touch.service'])
"
        ;;

      get)
        key="$3"
        if [ -z "$key" ]; then
          echo -e "${RED}Usage:${NC} kioskos get <setting>"
          exit 1
        fi
        python3 -c "
import json
with open('$CONFIG_FILE') as f:
    cfg = json.load(f)
key = '$key'.strip().lower()
mapped = {'url': 'dashboard_url', 'brightness': 'screen_brightness', 'power': 'screen_on', 'rotation': 'display_rotation', 'chime': 'startup_chime', 'ha_user': 'ha_username', 'ha_pass': 'ha_password'}
k = mapped.get(key, key)
if k == 'touch_mode':
    print(cfg.get('camera_touch', {}).get('mode', 'single'))
elif k == 'touch_dynamic':
    print(cfg.get('camera_touch', {}).get('dynamic_tracking', False))
elif k == 'mqtt_broker':
    print(cfg.get('mqtt', {}).get('broker', ''))
else:
    print(cfg.get(k, 'Not set'))
"
        ;;

      list|*)
        python3 -c "
import json
with open('$CONFIG_FILE') as f:
    cfg = json.load(f)

print('=' * 80)
print(' Home Assistant Kiosk Appliance Settings (/etc/kiosk/config.json)')
print('=' * 80)
print('')
print('\033[1m[Display & Dashboard]\033[0m')
print(f'  • url               {cfg.get(\"dashboard_url\", \"Not set\")}')
print('                      (Home Assistant dashboard target URL)')
print(f'  • screen_on         {cfg.get(\"screen_on\", True)}')
print('                      (Hardware screen power: true / false)')
print(f'  • brightness        {cfg.get(\"screen_brightness\", 100)}')
print('                      (Screen backlight percentage: 10 - 100)')
print(f'  • rotation          {cfg.get(\"display_rotation\", \"normal\")}')
print('                      (Display orientation: normal, 90, 180, 270)')
print('')
print('\033[1m[Audio & Notifications]\033[0m')
print(f'  • chime             {cfg.get(\"startup_chime\", True)}')
print('                      (Startup & notification sound enabled: true / false)')
print(f'  • notification_url  http://\033[32m<KIOSK_IP>:8124/chime?sound=bing\033[0m')
print('                      (HTTP endpoint for Home Assistant rest_command)')
print('')
print('\033[1m[Optical Camera Touchscreen & Kinect]\033[0m')
touch = cfg.get(\"camera_touch\", {})
print(f'  • touch_enabled     {touch.get(\"enabled\", True)}')
print('                      (Optical camera touch digitizer: true / false)')
print(f'  • touch_mode        {touch.get(\"mode\", \"single\")}')
print('                      (Sensor tracking mode: single, dual, kinect)')
print(f'  • touch_dynamic     {touch.get(\"dynamic_tracking\", False)}')
print('                      (Dynamic mini-markers for moving cameras: true / false)')
print('')
print('\033[1m[Home Assistant Auto-Login]\033[0m')
print(f'  • ha_user           {cfg.get(\"ha_username\", \"kiosk\")}')
print('                      (Auto-login username for dashboard session)')
has_pass = 'Configured' if cfg.get(\"ha_password\") else 'None'
print(f'  • ha_pass           [{has_pass}]')
print('                      (Auto-login password for dashboard session)')
print('')
print('\033[1m[Automations & Schedule]\033[0m')
print(f'  • night_mode        {cfg.get(\"night_mode_enabled\", True)}')
print('                      (Auto-dim backlight during scheduled hours)')
print(f'  • night_start       {cfg.get(\"night_mode_start\", \"23:00\")}')
print('                      (Night mode start time HH:MM)')
print(f'  • night_end         {cfg.get(\"night_mode_end\", \"07:00\")}')
print('                      (Night mode end time HH:MM)')
mqtt = cfg.get(\"mqtt\", {})
print(f'  • mqtt_broker       {mqtt.get(\"broker\", \"192.168.86.29\")}')
print('                      (Home Assistant MQTT telemetry broker)')
print('')
print('-' * 80)
print('To change any setting from CLI:')
print('  \033[32mkioskos set <setting> <value>\033[0m')
print('  e.g.: kioskos set brightness 80')
print('        kioskos set url http://homeassistant.local:8123/lovelace/0')
print('        kioskos set rotation 90')
print('        kioskos set touch_mode single')
print('=' * 80)
"
        ;;
    esac
    ;;

  set)
    shift
    /opt/kiosk/kioskos settings set "$@"
    ;;

  get)
    shift
    /opt/kiosk/kioskos settings get "$@"
    ;;

  url)
    new_url="$2"
    if [ -z "$new_url" ]; then
      echo -e "${RED}Error:${NC} Missing URL. Usage: kioskos url <dashboard_url>"
      exit 1
    fi
    /opt/kiosk/kioskos set url "$new_url"
    ;;

  screen)
    action="${2:-status}"
    case "$action" in
      sleep)
        /opt/kiosk/screen-control.sh sleep
        ;;
      on|off)
        /opt/kiosk/kioskos set screen "$action"
        ;;
      status|*)
        sudo /usr/local/bin/kiosk-screen status
        ;;
    esac
    ;;

  brightness)
    val="$2"
    if [ -z "$val" ]; then
      echo -e "Current brightness: $(/opt/kiosk/kioskos get brightness)%"
    else
      /opt/kiosk/kioskos set brightness "$val"
    fi
    ;;

  rotate)
    val="$2"
    if [ -z "$val" ]; then
      echo -e "Current rotation: $(/opt/kiosk/kioskos get rotation)"
    else
      /opt/kiosk/kioskos set rotation "$val"
    fi
    ;;

  chime)
    sound="${2:-bing}"
    case "$sound" in
      bing|boot|unlock|lock|alert|touch)
        echo -e "${CYAN}[kioskos] Playing $sound chime...${NC}"
        /opt/kiosk/play-chime.sh "$sound"
        ;;
      on|enable)
        /opt/kiosk/kioskos set chime true
        /opt/kiosk/play-chime.sh bing
        ;;
      off|disable)
        /opt/kiosk/kioskos set chime false
        ;;
      *)
        echo -e "${CYAN}[kioskos] Playing chime: $sound...${NC}"
        /opt/kiosk/play-chime.sh "$sound"
        ;;
    esac
    ;;

  touch)
    subcmd="${2:-status}"
    case "$subcmd" in
      test)
        cam_id="${3:-0}"
        echo -e "${CYAN}[kioskos] Launching Camera Touch Test on display (Camera $cam_id)...${NC}"
        WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}" XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/1000}" python3 /opt/kiosk/camera-touch/touch_test.py "$cam_id"
        ;;
      calibrate)
        cam_id="${3:-0}"
        echo -e "${CYAN}[kioskos] Launching Fullscreen Alignment & Marker Calibration on display (Camera $cam_id)...${NC}"
        WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}" XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/1000}" python3 /opt/kiosk/camera-touch/touch_calibration.py "$cam_id"
        ;;
      start|on)
        /opt/kiosk/kioskos set touch true
        ;;
      stop|off)
        /opt/kiosk/kioskos set touch false
        ;;
      dynamic)
        dyn_action="${3:-status}"
        case "$dyn_action" in
          on|enable)  /opt/kiosk/kioskos set touch_dynamic true ;;
          off|disable) /opt/kiosk/kioskos set touch_dynamic false ;;
          *) echo -e "Dynamic Camera Tracking: $(/opt/kiosk/kioskos get touch_dynamic)" ;;
        esac
        ;;
      mode)
        new_mode="${3:-status}"
        case "$new_mode" in
          single|dual|kinect) /opt/kiosk/kioskos set touch_mode "$new_mode" ;;
          *) echo -e "Active Camera Mode: $(/opt/kiosk/kioskos get touch_mode)" ;;
        esac
        ;;
      status|*)
        echo -e "${BOLD}Camera Touchscreen Status:${NC}"
        echo -e "  • Service:      $(systemctl is-active kiosk-camera-touch.service 2>/dev/null || echo 'inactive')"
        echo -e "  • Mode:         $(python3 -c "import json; print(json.load(open('$CONFIG_FILE')).get('camera_touch', {}).get('mode', 'single'))" 2>/dev/null || echo 'single')"
        echo -e "  • Dynamic Mode: $(python3 -c "import json; print(json.load(open('$CONFIG_FILE')).get('camera_touch', {}).get('dynamic_tracking', False))" 2>/dev/null || echo 'False')"
        echo -e "  • Cameras:      $(ls /dev/video* 2>/dev/null | tr '\n' ' ' || echo 'None detected')"
        echo -e "  • Calibration:  $([ -f /etc/kiosk/camera-touch-calibration.json ] && echo "${GREEN}Calibrated${NC}" || echo "${YELLOW}Uncalibrated (Run 'kioskos touch calibrate')${NC}")"
        echo ""
        echo -e "Subcommands:"
        echo -e "  ${GREEN}kioskos touch test [cam]${NC}      Live camera test view on display"
        echo -e "  ${GREEN}kioskos touch calibrate [cam]${NC} Fullscreen corner marker alignment"
        echo -e "  ${GREEN}kioskos touch start|stop${NC}      Enable/disable background service"
        echo -e "  ${GREEN}kioskos touch dynamic on|off${NC}  Toggle subtle dynamic mini-markers"
        echo -e "  ${GREEN}kioskos touch mode [single|dual|kinect]${NC} Select optical sensor mode"
        ;;
    esac
    ;;

  kinect)
    sub="${2:-status}"
    case "$sub" in
      tilt)
        degs="${3:-0}"
        python3 /opt/kiosk/camera-touch/kinect_controller.py tilt "$degs"
        ;;
      realign|level|center)
        python3 /opt/kiosk/camera-touch/kinect_controller.py realign
        ;;
      led)
        state="${3:-off}"
        python3 /opt/kiosk/camera-touch/kinect_controller.py "$state"
        ;;
      status|*)
        echo -e "${BOLD}Xbox Kinect Hardware Status:${NC}"
        lsusb | grep -i -E "kinect|045e" || echo -e "  • ${YELLOW}No Xbox Kinect detected on USB bus.${NC}"
        echo ""
        echo -e "Subcommands:"
        echo -e "  ${GREEN}kioskos kinect tilt <degs>${NC}       Tilt motor (-30° to +30°)"
        echo -e "  ${GREEN}kioskos kinect realign${NC}           Auto-level motor to 0° center"
        echo -e "  ${GREEN}kioskos kinect led [off|green]${NC}   Control status LED"
        ;;
    esac
    ;;

  mcp)
    sub="${2:-run}"
    case "$sub" in
      run|start)
        python3 /opt/kiosk/kiosk-mcp.py
        ;;
      test)
        echo -e "${CYAN}[kioskos] Testing MCP Server Tools...${NC}"
        echo '{"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {}}' | python3 /opt/kiosk/kiosk-mcp.py
        echo '{"jsonrpc": "2.0", "id": 2, "method": "tools/list", "params": {}}' | python3 /opt/kiosk/kiosk-mcp.py
        ;;
      status|*)
        echo -e "${BOLD}KioskOS Model Context Protocol (MCP) Server:${NC}"
        echo -e "  • Path:        /opt/kiosk/kiosk-mcp.py"
        echo -e "  • Protocol:    MCP JSON-RPC 2.0 (stdio)"
        echo -e "  • Tools:       kiosk_get_status, kiosk_set_url, kiosk_set_power,"
        echo -e "                 kiosk_set_brightness, kiosk_set_rotation, kiosk_speed_mode,"
        echo -e "                 kiosk_touch_control, kiosk_trigger_chime, kiosk_reboot"
        ;;
    esac
    ;;

  restart)
    echo -e "${CYAN}[kioskos] Restarting Home Assistant Kiosk display...${NC}"
    sudo systemctl restart kiosk-display
    ;;

  reboot)
    echo -e "${CYAN}[kioskos] Rebooting Raspberry Pi appliance...${NC}"
    sudo systemctl reboot
    ;;

  update)
    echo -e "${CYAN}[kioskos] Launching System Update...${NC}"
    if [ -n "$WAYLAND_DISPLAY" ] || [ -f /run/user/1000/wayland-0 ]; then
        /opt/kiosk/apply-update.sh
    else
        sudo /opt/kiosk/kiosk-config.sh --update
        sudo systemctl reboot
    fi
    ;;

  backup)
    echo -e "${CYAN}[kioskos] Generating sanitized appliance backup...${NC}"
    BACKUP_FILE="/tmp/kiosk-backup-$(date +%Y%m%d-%H%M%S).tar.gz"
    tar -czf "$BACKUP_FILE" -C /opt kiosk
    echo -e "${GREEN}✓ Sanitized backup created at: $BACKUP_FILE${NC}"
    ;;

  *)
    show_banner
    echo -e "${BOLD}Usage:${NC} kioskos <command> [options]\n"
    echo -e "Commands:"
    echo -e "  ${GREEN}settings${NC} / ${GREEN}config${NC} Show all appliance settings, descriptions & values"
    echo -e "  ${GREEN}set <key> <val>${NC}  Modify any setting (url, brightness, rotation, touch, etc.)"
    echo -e "  ${GREEN}get <key>${NC}        Get value of any setting"
    echo -e "  ${GREEN}setup${NC}            Interactive setup wizard for Home Assistant Kiosk"
    echo -e "  ${GREEN}status${NC}           Show current Home Assistant Kiosk status & telemetry"
    echo -e "  ${GREEN}url <URL>${NC}        Quickly update Home Assistant dashboard URL and reload"
    echo -e "  ${GREEN}screen [on|off]${NC}  Turn display power ON or OFF"
    echo -e "  ${GREEN}brightness <10-100>${NC} Adjust backlight brightness level"
    echo -e "  ${GREEN}rotate <angle>${NC}   Set display orientation (normal, 90, 180, 270)"
    echo -e "  ${GREEN}chime [name]${NC}     Play audio chime (bing, boot, alert, unlock, lock, touch)"
    echo -e "  ${GREEN}touch${NC}            Optical Camera Touchscreen (test, calibrate, dynamic, mode)"
    echo -e "  ${GREEN}kinect${NC}           Xbox Kinect hardware control (tilt, realign, led)"
    echo -e "  ${GREEN}mcp${NC}              Model Context Protocol (MCP) server for AI assistants"
    echo -e "  ${GREEN}restart${NC}          Restart the kiosk display engine"
    echo -e "  ${GREEN}reboot${NC}           Reboot the Raspberry Pi appliance"
    echo -e "  ${GREEN}update${NC}           Install latest appliance update and reload"
    echo ""
    ;;
esac
